---
import { base } from '../lib/notes';
---
<figure class="margin-study ink-notebook" data-margin-motion aria-label="Blue ballpoint working notes for building with AI: drafts, experiments, checks, changes, and open questions.">
<div class="ink-sheet">
<img src={`${base}/assets/building-notebook.webp`} width="1254" height="1254" alt="A doodle-filled notebook page in blue ballpoint ink, with rough browser sketches, crossed-out attempts, looping arrows, and notes reading try this, what if, change it, and still unsure." fetchpriority="high" />
<svg viewBox="0 0 1254 1254" aria-hidden="true" class="ink-traces">
<g fill="none" stroke="none"><path class="question-path" d="M450 145Q495 92 547 133"/><path class="question-path" d="M446 548Q503 607 577 562"/><path class="question-path" d="M827 722Q888 684 905 611Q944 559 958 536"/></g>
<g class="story-ink" fill="none" stroke="#173dcb" stroke-width="3" stroke-linecap="round"><path class="story-path" pathLength="1" d="M450 145Q495 92 547 133"/><path class="story-path" pathLength="1" d="M446 548Q503 607 577 562"/><path class="story-path" pathLength="1" d="M827 722Q888 684 905 611Q944 559 958 536"/></g><circle class="story-marker" r="3" fill="#173dcb" opacity="0"/>
</svg>
</div>
<figcaption class="motion-caption"><span>From the working notes.</span><button class="motion-toggle" type="button" aria-label="Pause illustration" aria-pressed="false" hidden>Pause motion</button></figcaption>
</figure>
