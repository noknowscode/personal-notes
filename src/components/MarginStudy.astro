---
import { base } from '../lib/notes';
---
<figure class="margin-study ink-notebook" data-margin-motion aria-label="Blue ballpoint working notes for building with AI: drafts, experiments, checks, changes, and open questions.">
<div class="ink-sheet">
<img src={`${base}/assets/rules-checks-hero.webp`} width="1254" height="1254" alt="Loose blue-ink notes connect an unfinished app, rules, checks, lessons and a tiny screen marked live." fetchpriority="high" />
<svg viewBox="0 0 1280 1280" aria-hidden="true" class="ink-traces">
<g fill="none" stroke="none"><path class="question-path" d="M692 197C724 239 842 221 915 296L953 340"/><path class="question-path" d="M283 703Q335 733 410 674"/><path class="question-path" d="M685 1191Q800 1141 917 1114"/></g>
<g class="story-ink" fill="none" stroke="#173dcb" stroke-width="3" stroke-linecap="round"><path class="story-path" pathLength="1" d="M692 197C724 239 842 221 915 296L953 340"/><path class="story-path" pathLength="1" d="M283 703Q335 733 410 674"/><path class="story-path" pathLength="1" d="M685 1191Q800 1141 917 1114"/></g><circle class="story-marker" r="3" fill="#173dcb" opacity="0"/>
</svg>
</div>
<figcaption class="motion-caption"><span>From the working notes.</span><button class="motion-toggle" type="button" aria-label="Pause illustration" aria-pressed="false" hidden>Pause motion</button></figcaption>
</figure>
